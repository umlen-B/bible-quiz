{
  "name": "bible-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "gen:data": "node scripts/gen-data.mjs",
    "verify:data": "node scripts/verify-parity.mjs",
    "check:strings": "node scripts/check-strings.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run verify:data && npm run check:strings && npm run smoke",
    "gen:og": "node scripts/gen-og-image.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
